# Store text files with LF line endings, whatever the local editor uses, so
# line-ending-only differences never show up as changes.
* text=auto eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.glb binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.pdf binary
